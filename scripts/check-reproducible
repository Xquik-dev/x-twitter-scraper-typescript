#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Xquik contributors
#
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

cd "$(dirname "$0")/.."

remove_reproducibility_directory() {
  if [[ -n "${reproducibility_directory:-}" && -d "$reproducibility_directory" ]]; then
    chmod -R u+w -- "$reproducibility_directory" 2>/dev/null || true
    rm -rf -- "$reproducibility_directory"
  fi
}

reproducibility_directory="$(mktemp -d "${TMPDIR:-/tmp}/xquik-typescript-reproducible.XXXXXX")"
trap remove_reproducibility_directory EXIT
trap 'trap - INT; kill -INT "$$"' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
export TMPDIR="${reproducibility_directory}/tmp"
mkdir "$TMPDIR" "$reproducibility_directory/first" "$reproducibility_directory/second"

pnpm build
(cd dist && npm pack --silent --pack-destination "$reproducibility_directory/first" >/dev/null)

pnpm build
(cd dist && npm pack --silent --pack-destination "$reproducibility_directory/second" >/dev/null)

first_archive="$(find "$reproducibility_directory/first" -type f -name '*.tgz' -print -quit)"
second_archive="$(find "$reproducibility_directory/second" -type f -name '*.tgz' -print -quit)"

if [[ -z "$first_archive" || -z "$second_archive" ]]; then
  echo "Package archives are missing. Build both archives." >&2
  exit 1
fi

cmp "$first_archive" "$second_archive"
echo "Package archives are reproducible."
