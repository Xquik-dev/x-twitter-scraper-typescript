# Runs npm publish with the given arguments.
#
# When a publish needs 2FA approval, npm prints an approval URL and waits for
# it, but only in a terminal. Without one it fails at once with EOTP. This
# script gives npm a terminal through script(1) when it has none, so a release
# that runs in the background still shows the URL and waits. There,
# --browser=false makes npm print the URL instead of opening a browser.

set -euo pipefail

if [[ -t 0 && -t 1 ]]; then
  exec npm publish "$@"
fi

command -v script >/dev/null 2>&1 || {
  echo "script is missing, so npm cannot wait for a 2FA approval here. Run the release in a terminal." >&2
  exit 1
}

if script --version >/dev/null 2>&1; then
  # util-linux takes the command as 1 string.
  printf -v publish_command '%q ' npm publish "$@" --browser=false
  exec script --quiet --return --command "$publish_command" /dev/null
fi

# The BSD script on macOS takes the command as arguments and returns its exit code.
exec script -q /dev/null npm publish "$@" --browser=false
