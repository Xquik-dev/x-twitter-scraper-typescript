#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Xquik contributors
#
# SPDX-License-Identifier: Apache-2.0

set -exuo pipefail

cd "$(dirname "$0")/.."

node scripts/utils/check-version.ts

rm -rf dist; mkdir dist
cp -rp src README.md assets skills dist
for file in LICENSE CHANGELOG.md bin/cli bin/migration-config.json; do
  if [ -e "$file" ]; then
    mkdir -p "dist/$(dirname "$file")"
    cp -p "$file" "dist/$file"
  fi
done
node scripts/utils/make-dist-package-json.ts > dist/package.json

node scripts/utils/compile-formats.ts
node scripts/utils/fix-index-exports.ts
cp tsconfig.dist-src.json dist/src/tsconfig.json

node scripts/utils/postprocess-files.ts

(cd dist && node -e 'require("x-twitter-scraper")')
(cd dist && node -e 'import("x-twitter-scraper")' --input-type=module)

if [ -e ./scripts/build-deno ]
then
  ./scripts/build-deno
fi
