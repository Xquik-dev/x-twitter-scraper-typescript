#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Xquik contributors
#
# SPDX-License-Identifier: Apache-2.0

set -e

cd "$(dirname "$0")/.."

echo "==> Checking formatting"
pnpm run --silent lint:format

echo "==> Running eslint"
./node_modules/.bin/eslint --max-warnings 0 .

echo "==> Building"
./scripts/build

echo "==> Checking types"
pnpm run --silent lint:types

echo "==> Measuring type coverage"
pnpm run --silent lint:type-coverage

echo "==> Running Are The Types Wrong?"
attw_status=0
pnpm run --silent lint:attw >.attw.json || attw_status=$?
node scripts/utils/attw-report.cjs
[ "$attw_status" -eq 0 ]

echo "==> Running publint"
pnpm run --silent lint:publint

echo "==> Finding unused files, exports and dependencies"
pnpm run --silent lint:knip

echo "==> Finding duplicate code"
pnpm run --silent lint:jscpd
