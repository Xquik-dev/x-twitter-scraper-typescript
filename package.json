{
  "name": "x-twitter-scraper",
  "version": "0.18.0",
  "description": "X API & Twitter API SDK for TypeScript. Scrape Twitter search, profiles & followers as a Twitter scraper & tweet scraper. Not affiliated with X Corp.",
  "author": "Xquik <support@xquik.com>",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*",
        "*"
      ]
    }
  },
  "main": "dist/index.js",
  "type": "commonjs",
  "homepage": "https://docs.xquik.com/sdks/typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xquik-dev/x-twitter-scraper-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/Xquik-dev/x-twitter-scraper-typescript/issues"
  },
  "keywords": [
    "x-api",
    "twitter-api",
    "twitter-scraper",
    "tweet-scraper",
    "scrape-twitter",
    "twitter-api-alternative",
    "twitter-data-api",
    "twitter-sdk",
    "twitter-api-typescript",
    "twitter-api-javascript",
    "twitter-api-node",
    "typescript-sdk",
    "x-twitter-scraper",
    "xquik",
    "pi-package",
    "twitter-search",
    "follower-export",
    "webhooks",
    "x-automation"
  ],
  "pi": {
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/Xquik-dev/x-twitter-scraper-typescript/main/assets/pi-package.png"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@12.10.1",
  "files": [
    "**/*"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "./scripts/test",
    "build": "./scripts/build",
    "check:reproducible": "./scripts/check-reproducible",
    "check:all": "node scripts/utils/check-api-coverage.cjs && node scripts/utils/check-api-fields.cjs && pnpm lint && pnpm test --runInBand && pnpm run check:reproducible && node scripts/utils/check-audit.cjs",
    "prepublishOnly": "echo 'Direct publish blocked. Build first, then publish from dist.' && exit 1",
    "format": "./scripts/format",
    "prepare": "./scripts/build",
    "tsn": "ts-node -r tsconfig-paths/register",
    "lint": "./scripts/lint",
    "fix": "./scripts/format"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@swc/core": "1.16.13",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.12.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-unused-imports": "4.4.1",
    "fast-check": "4.10.2",
    "jest": "30.5.2",
    "prettier": "3.9.9",
    "publint": "0.3.25",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tslib": "2.8.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./*.mjs": {
      "default": "./dist/*.mjs"
    },
    "./*.js": {
      "default": "./dist/*.js"
    },
    "./*": {
      "import": "./dist/*.mjs",
      "require": "./dist/*.js"
    }
  }
}
